<%- include('partials/header.ejs') %>

<div class="row g-5">
    <div class="col-md-8">
      <div id="searchBox">
            <form id="bookSearch">
                <input type="search" id="searchInput" name="search" autocomplete="off" placeholder="Search for author, title, or ISBN code" style="width: 100%;">
            </form>
            <ul id="resultsDropdown" class="dropdown hidden"></ul>
        </div>
      <!-- <article class="blog-post"> -->
        
        <hr class="m-2">
        <div>
            <form action="/addreview" method="post">
                <div class="mb-3">
                    <label for="title">Title:</label>
                    <input class="hidden" style="width: 100%;" id="title" name="title" value="">
                    <input type="hidden" id="cover" name="cover" value="">
                </div>

                <div class="mb-3">
                    <label for="date_read">Date finished:</label>
                    <input id="date" class="me-2" type="date" name="date_read" placeholder="Date Read" style="width:auto;" required>
                    <label for="rating">Rate the book from 0-5:</label>
                    <input id="rating" type="number" name="rating" min="0" max="5" style="width: auto;" required><br>
                </div>
               
                <div class="mb-3">
                    <textarea name="review" placeholder="Write your book review" required rows="10" style="width:100%;"></textarea>
                </div>

                <div class="text-center mt-3">
                    <button class="submit" type="submit">Submit your book review</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
      <div class="position-sticky" style="top: 2rem;">
        <div class="p-4 bg-light rounded">
          <h4 class="fst-italic">Cover:</h4>
          <img 
                id="selectedCover"
                src="" 
                class="card-img-top" 
                alt="Cover of "
                width="100%" 
                height="100%"
                style="object-fit: cover;"
            >
        </div>
      </div>
    </div>
  </div>

<script>
    const searchInput = document.getElementById("searchInput");
    const dropdown = document.getElementById("resultsDropdown");

    function debounce(func, delay){
        let timeout;
        return function(...args){
            clearTimeout(timeout);
            timeout = setTimeout(()=>{
                func.apply(this, args);
            }, delay);
        };
    }
    
    function clearResults(){
        dropdown.innerHTML = "";
        dropdown.classList.add("hidden");
    }

    async function searchBooks(e){
        //e.target instead of this since it's more predictable and reusable, sticks to "what caused the event"
        const userSearch = e.target.value.trim().replaceAll(" ", "+");

        if (!userSearch) {
            clearResults();
            return;
        }

        try{
            //limits the search results to 5 so I no longer need to splice data 
            const searchResult = await fetch(`https://openlibrary.org/search.json?q=${userSearch}&limit=5`);
            const data = await searchResult.json();

            console.log(data);

            renderResults(data.docs)
        } catch (error) {
            console.log(error);
        }
    };

    const debouncedSearch = debounce(searchBooks, 400);

    //allows for debounced search or instant search once enter is pressed
    searchInput.addEventListener("input", debouncedSearch);
    searchInput.addEventListener("keydown", e => {
        if (e.key === "Enter") {
            e.preventDefault()
            searchBooks(e);
        };
    });

    // searchInput.addEventListener("keydown", async function(e){
    //     const API_URL = "https://openlibrary.org/search.json?q=";
    //     const userSearch = this.value.trim().replaceAll(" ", "+");

    //     try {
    //         //fetched API, no need to cdn axios 
    //         const searchResult = await fetch(API_URL + userSearch);
    //         const data = await searchResult.json();

    //         console.log(data);
            
    //         renderResults(data.docs.slice(0,5));
    //     } catch (error) {
    //         console.log(error);  
    //     }
    // });

    function renderResults(books){
        
        if(!books.length){
            clearResults();
            return
        };

        dropdown.innerHTML = "";
        dropdown.classList.remove("hidden");
        books.forEach(book => {
            const {title, author_name, cover_i} = book;
            const author = author_name;
            const cover = `https://covers.openlibrary.org/b/id/${cover_i}-S.jpg`;

            const li = document.createElement("li");
            li.innerHTML = `
                <img src="${cover}"/>
                <div>
                    <h3>${title}</h3>
                    <p>${author}<p>
                </div> 
            `

            dropdown.appendChild(li);

            li.addEventListener("click", ()=>{
                selectBook({title, cover_i});
            });
        });
    }

    function selectBook(book){
        const title = document.getElementById("title");
        const cover = document.getElementById("cover");

        dropdown.classList.add("hidden");
        title.classList.remove("hidden");

        title.value = book.title;
        cover.value = book.cover_i;

        document.getElementById("selectedCover").src = `https://covers.openlibrary.org/b/id/${book.cover_i}-L.jpg`;
    }

</script>

<%- include('partials/footer.ejs') %>
