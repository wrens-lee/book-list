<%- include('partials/header.ejs') %>


<div class="box" id="heading">
    <h1>My Reading List</h1>
</div>

<div class="album py-3 bg-light">
    <div class="container" id="bookContainer">
        <!-- made more responsive columns  -->
      <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-2 g-md-3">
        <% for(let book of bookList) { %>
            <div class="col d-flex"> 
                <div class="card shadow-sm book-card h-100" data-book-id="<%= book.id %>" style="cursor: pointer;">
                    <!-- used object fit: fill so that book cover fills whole card -->
                    <img 
                        src="https://covers.openlibrary.org/b/id/<%= book.cover %>-L.jpg" 
                        class="card-img-top" 
                        alt="Cover of <%= book.title %>"
                        style="height: 100%; width: 100%; object-fit:fill;"
                    >

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-text"><%= book.title %></h5>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Read On: <%= book.date_read %></small>
                        </div>
                    </div>
                </div>
            </div>
         <% } %>
      </div>
    </div>
</div>

<script>
    document.getElementById("bookContainer").addEventListener("click", function(e){
        //targets closest ancestor with class book-card
        const card = e.target.closest(".book-card");

        //access the data- in html and store in const bookID, which you'll use to access the route
        //bookID here is the index of the book from the html side and not "bookID" string
        if(card){
            const bookId = card.dataset.bookId;
            window.location.href = `/review/${bookId}`;
        }
    });
</script>
<%- include('partials/footer.ejs') %>